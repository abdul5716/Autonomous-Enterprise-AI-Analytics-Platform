# Copy to .env and fill in at least one LLM provider key.

# --- LLM (any LiteLLM model string works: https://docs.litellm.ai/docs/providers) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=litellm                 # litellm | fake
LLM_FAST_MODEL=gpt-4o-mini           # routing, classification
LLM_STRONG_MODEL=gpt-4o-mini         # planning, SQL, synthesis
LLM_JUDGE_MODEL=gpt-4o-mini          # validation
LLM_FALLBACK_MODELS=[]               # e.g. ["gemini/gemini-2.0-flash"]
LLM_CACHE_ENABLED=true

# --- Web research ---
TAVILY_API_KEY=                      # optional; free ddgs engines are used without it
WEB_MODE=auto                        # auto (live, then offline snapshot) | live | fixtures
WEB_SEARCH_BACKENDS=["bing","yahoo","duckduckgo"]

# --- Infrastructure (defaults match docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=nimbus
POSTGRES_USER=nimbus
POSTGRES_PASSWORD=nimbus_dev
POSTGRES_RAG_PASSWORD=rag_reader_dev   # read-only role used for document search

ORACLE_HOST=localhost
ORACLE_PORT=51521
ORACLE_SERVICE=FREEPDB1
ORACLE_USER=finance
ORACLE_PASSWORD=finance_dev
ORACLE_ADMIN_PASSWORD=oracle_admin_dev   # creates the read-only user during `make data`
ORACLE_RO_USER=finance_ro                # the agent queries Oracle as this user
ORACLE_RO_PASSWORD=finance_ro_dev

# --- SQL tool guardrails ---
SQL_MAX_ROWS=1000
SQL_TIMEOUT_S=15

# --- Document search (models run locally and are cached here) ---
MODEL_CACHE_DIR=data/models
RAG_TOP_K=5

REDIS_URL=redis://localhost:56379/0
DUCKDB_PATH=data/warehouse/nimbus.duckdb
DOCUMENTS_DIR=data/documents
PHOENIX_URL=http://localhost:6006
